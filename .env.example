# ---------------------------------------------------------------
# Shopify Lead Bridge — variaveis de ambiente
# Copie para .env no desenvolvimento local e configure as mesmas
# variaveis no painel da hospedagem em producao.
# ---------------------------------------------------------------

# Porta HTTP (a hospedagem normalmente define isso sozinha)
PORT=3000

# Use "production" quando publicar
NODE_ENV=development

# Deixe 1 em Render / Railway / Fly (a aplicacao fica atras de proxy)
TRUST_PROXY=0

# --- Acesso ao painel de gestao ---
ADMIN_USER=admin
# Minimo de 12 caracteres
ADMIN_PASSWORD=troque-esta-senha-agora
# Minimo de 32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Horas de validade do login
SESSION_HOURS=12

# --- Shopify ---
SHOPIFY_API_VERSION=2026-01

# --- OAuth com renovacao automatica de token (opcional) ---
# So sao necessarias se alguma loja em STORES_CONFIG/stores.json usar o bloco "oauth"
# (client_id/client_secret) em vez de um adminToken (shpat_) estatico.
# URL publica da aplicacao, sem barra no final. Usada para montar o redirect_uri do OAuth.
APP_URL=https://seu-dominio.com
# 64 caracteres hex (32 bytes). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Historico ---
DB_PATH=./data/leads.db
# Dias de retencao dos registros (LGPD). 0 desativa a limpeza.
RETENTION_DAYS=90

# --- Lojas (JSON em UMA linha) ---
# Cada loja precisa de: key, shopDomain, allowedOrigins, e UMA das duas formas de autenticacao:
#  - adminToken: shpat_... (estatico, nunca expira, gerado em Settings > Apps > Develop apps)
#  - oauth: { clientId, clientSecret } (client_id/client_secret do Dev Dashboard; a aplicacao
#    renova o access_token sozinha via refresh_token, ver secao de OAuth no README)
# Opcionais: label, defaultTags, phoneCountryCode, marketingConsent
STORES_CONFIG=[{"key":"madesa-mx","label":"Madesa Mexico","shopDomain":"madesa-mx.myshopify.com","adminToken":"shpat_xxxxxxxxxxxx","allowedOrigins":["https://madesa.mx"],"defaultTags":["pop-up-entrada"],"phoneCountryCode":"52","marketingConsent":false},{"key":"madesa-br","label":"Madesa Brasil","shopDomain":"totvsrs-madesa.myshopify.com","adminToken":"shpat_yyyyyyyyyyyy","allowedOrigins":["https://madesa.com"],"defaultTags":["pop-up-entrada"],"phoneCountryCode":"55","marketingConsent":false}]
